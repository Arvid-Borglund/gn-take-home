# No secret values in this file, only references to environment variables of whoever
# runs kamal. In the deploy workflow they are filled from GitHub secrets. That is why
# this file can be committed, and has to be.

# The run's own GITHUB_TOKEN in the workflow.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# One password, used from both sides: the database container is created with it,
# and the API connects with it.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
ConnectionStrings__TicketDb="Host=ticketing-postgres;Port=5432;Database=ticketdb;Username=ticket;Password=${POSTGRES_PASSWORD}"

# The agent server's key to the language model (config/deploy.agent.yml).
AZURE_OPENAI_API_KEY=$AZURE_OPENAI_API_KEY

# The first user of the web interface (config/deploy.yml). The API creates it when it
# starts, unless it already exists. The database gets a salt and a hash, never the
# password.
SeedUser__Username=$WEB_LOGIN_USER
SeedUser__Password=$WEB_LOGIN_PASSWORD
