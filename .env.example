# Copy this file to .env and fill in the key. .env is ignored by git.
#
# The agent talks to an Azure OpenAI resource (not openai.com).
AZURE_OPENAI_ENDPOINT=https://external-api.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna-c1
AZURE_OPENAI_API_VERSION=2024-12-01-preview
